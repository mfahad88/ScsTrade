<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:width="10dp" android:height="1dp">
        <shape>
            <corners android:topLeftRadius="7dp" android:bottomLeftRadius="7dp"/>
            <size android:height="1dp"/>
            <solid android:color="@color/gray_400"/>
        </shape>
        <!--<shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/gray_400"/>
            <size android:width="200dp" android:height="40dp"/>
        </shape>-->
    </item>
    <item android:left="80dp" android:height="1dp">
        <shape>
            <size android:width="50dp"
                android:height="1dp"/>
            <solid android:color="@color/gray_400"/>
        </shape>
    </item>
    <item android:top="0dp" android:width="1dp">
        <shape>
            <corners android:radius="7dp"/>
            <size android:height="40dp" android:width="1dp"/>
            <solid android:color="@color/gray_400"/>
        </shape>
    </item>

    <item android:width="-1dp" android:top="40dp" android:height="1dp">
        <shape>
            <corners android:radius="7dp"/>
            <size android:height="40dp" android:width="1dp"/>
            <solid android:color="@color/gray_400"/>
        </shape>
    </item>

    <item android:top="0dp" android:width="1dp" android:gravity="end">
        <shape>
            <corners android:radius="7dp"/>
            <size android:height="40dp" android:width="1dp"/>
            <solid android:color="@color/gray_400"/>
        </shape>
    </item>
</layer-list>