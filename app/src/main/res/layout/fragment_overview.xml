<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.snapshot.OverviewFragment">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/snapshot_card"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >

                <ImageView
                    android:id="@+id/imageView16"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/snapshot_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/companyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textFontWeight="600"
                    android:text="@string/fauji_foods"
                    android:textAppearance="@style/fauji_foods"
                    app:layout_constraintStart_toEndOf="@+id/imageView16"
                    app:layout_constraintTop_toTopOf="@+id/imageView16" />

                <TextView
                    android:id="@+id/sector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textFontWeight="400"
                    android:text="@string/food_person"
                    android:textAppearance="@style/food_person"
                    app:layout_constraintStart_toStartOf="@+id/companyName"
                    app:layout_constraintTop_toBottomOf="@+id/companyName" />

                <RelativeLayout
                    android:id="@+id/relativeLayoutReg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/drawable_reg"
                    android:backgroundTint="#9EEFFD"
                    app:layout_constraintStart_toStartOf="@+id/sector"
                    app:layout_constraintTop_toBottomOf="@+id/sector">

                    <TextView
                        android:id="@+id/label_text_reg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:lineSpacingExtra="3sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/label_text_reg"
                        android:textAppearance="@style/label_text_reg"
                        android:textFontWeight="500" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:id="@+id/relativeLayoutIndex"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/drawable_reg"
                    android:backgroundTint="@color/colorDarkerr"
                    app:layout_constraintBottom_toBottomOf="@+id/relativeLayoutReg"
                    app:layout_constraintStart_toEndOf="@+id/relativeLayoutReg"
                    app:layout_constraintTop_toTopOf="@+id/relativeLayoutReg">

                    <TextView
                        android:id="@+id/label_text_index"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:lineSpacingExtra="3sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/label_text_index"
                        android:textAppearance="@style/label_text_index"
                        android:textFontWeight="500" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/linearLayout5"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:background="#E5E2E1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/relativeLayoutReg" />

                <TextView
                    android:id="@+id/rs_"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textFontWeight="300"
                    android:text="@string/rs_"
                    android:textAppearance="@style/rs_"
                    app:layout_constraintStart_toStartOf="@+id/imageView16"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout5" />

                <TextView
                    android:id="@+id/valueTrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="20dp"
                    android:gravity="top"
                    android:lineSpacingExtra="-18sp"
                    android:text="@string/valueTrade_snapshot"
                    android:textAppearance="@style/valueTrade_snapshot"
                    android:textFontWeight="600"
                    app:layout_constraintBottom_toBottomOf="@+id/rs_"
                    app:layout_constraintStart_toEndOf="@+id/rs_"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout5" />


                <TextView
                    android:id="@+id/netChange"
                    android:layout_width="134dp"
                    android:layout_height="27dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:gravity="top"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/netChange_snapshot"
                    android:textAppearance="@style/netChange_snapshot"
                    android:translationY="-1.42sp"
                    app:layout_constraintBottom_toBottomOf="@+id/rs_"
                    tools:layout_editor_absoluteX="172dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>