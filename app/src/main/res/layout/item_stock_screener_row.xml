<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:background="@color/md_theme_surface"
    android:orientation="horizontal">

    <!-- Sticky Column (Symbol & Company Name) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_130"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="2dp"
        >
        <LinearLayout
            android:layout_width="@dimen/dp_130"
            android:layout_height="@dimen/dp_65"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/dp_5">

                <ImageView
                    android:id="@+id/imageViewLogo"
                    android:layout_width="@dimen/dp_25"
                    android:layout_height="@dimen/dp_25"
                    android:layout_marginStart="@dimen/dp_4"
                    android:src="@drawable/image" />

                <TextView
                    android:id="@+id/symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:text="GEMPAPL"
                    android:textAppearance="@style/symbol_wtl"
                    android:textFontWeight="600" />
            </LinearLayout>

            <TextView
                android:id="@+id/companyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:text="@string/companyName"
                android:textAppearance="@style/symbol_companyName"
                android:textFontWeight="400" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Financial Metrics -->
    <com.example.scstrade.views.widgets.CustomHorizontalScrollView
        android:id="@+id/horizontalScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_65"
        android:fillViewport="true"
        android:requiresFadingEdge="horizontal"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="50dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- TOP 8 FIELDS (per image order) -->
            <TextView android:id="@+id/price" style="@style/RowField" tools:text="292.60" />
            <TextView android:id="@+id/price_to_earning" style="@style/RowField" tools:text="26.71" />
            <TextView android:id="@+id/expected_price_to_earning" style="@style/RowField" tools:text="31.53" />
            <TextView android:id="@+id/dividend_yield" style="@style/RowField" tools:text="6.40" />
            <TextView android:id="@+id/price_to_book_value" style="@style/RowField" tools:text="6.25" />
            <TextView android:id="@+id/return_on_assets" style="@style/RowField" tools:text="-14.99" />
            <TextView android:id="@+id/return_on_equity" style="@style/RowField" tools:text="-4.40" />
            <TextView android:id="@+id/enterprise_value_to_ebitda" style="@style/RowField" tools:text="11.19" />

            <!-- REMAINING FIELDS -->
            <TextView android:id="@+id/ebita_margin" style="@style/RowField" tools:text="12.34" />
            <TextView android:id="@+id/gross_profit_margin" style="@style/RowField" tools:text="24.50" />
            <TextView android:id="@+id/payout_ratio" style="@style/RowField" tools:text="55.00" />
            <TextView android:id="@+id/price_earning_growth" style="@style/RowField" tools:text="15.00" />
            <TextView android:id="@+id/total_debt_to_assets" style="@style/RowField" tools:text="23.45" />
            <TextView android:id="@+id/total_debt_to_equity" style="@style/RowField" tools:text="45.00" />

        </LinearLayout>
    </com.example.scstrade.views.widgets.CustomHorizontalScrollView>
</LinearLayout>

