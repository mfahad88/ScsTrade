<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:strokeWidth="@dimen/dp_0"
    app:cardElevation="@dimen/dp_2"
    >


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_10"
        android:background="@color/md_theme_surfaceBright">
        <TextView
            android:id="@+id/symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="700"
            android:text="@string/wtl"
            android:textAppearance="@style/wtl"
            android:lineSpacingExtra="-4sp"
            android:gravity="top"
            />

        <TextView
            android:id="@+id/you_made_a_"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/symbol"
            android:text="@string/you_made_a_"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_toLeftOf="@id/imageViewMenu"
            android:textAppearance="@style/you_made_a_"
            />

        <ImageView
            android:id="@+id/imageViewMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_15"
            android:padding="@dimen/dp_10"
            app:tint="@color/colorDarkerr"
            app:srcCompat="@drawable/three_dots" />


    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>