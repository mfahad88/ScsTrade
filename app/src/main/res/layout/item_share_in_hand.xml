<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeWidth="@dimen/dp_0"
    app:cardElevation="@dimen/dp_5"
    app:cardCornerRadius="@dimen/dp_4">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_10"
        android:background="@color/md_theme_surfaceBright">


        <ImageView
            android:id="@+id/company_icon"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            app:srcCompat="@drawable/image" />

        <TextView
            android:id="@+id/symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/company_icon"
            android:textFontWeight="700"
            android:text="@string/wtl"
            android:textAppearance="@style/wtl"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_alignParentTop="true"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="700"
            android:id="@+id/price"
            android:text="@string/price_in"
            android:layout_toStartOf="@id/price_213_3"
            android:textAppearance="@style/price"/>

        <TextView
            android:id="@+id/price_213_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="700"
            android:layout_marginStart="@dimen/dp_4"
            android:text="@string/price_213_3"
            android:textAppearance="@style/price"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/separator_1"
            android:layout_height="@dimen/dp_1"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_below="@id/company_icon"
            android:background="#E2E2E9"/>

        <TextView
            android:id="@+id/total_cost_"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_cost_"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/separator_1"
            android:layout_marginTop="@dimen/dp_6"
            />

        <TextView
            android:id="@+id/total_cost_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_cost_value"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/total_cost_"
            />

        <TextView
            android:id="@+id/market_valu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/market_valu"
            android:layout_toEndOf="@id/total_cost_"
            android:layout_marginStart="@dimen/dp_15"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/separator_1"
            android:layout_marginTop="@dimen/dp_6"
            />

        <TextView
            android:id="@+id/market_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_cost_value"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/market_valu"
            android:layout_alignStart="@id/market_valu"
            />

        <TextView
            android:id="@+id/avg_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/avg_buy"
            android:layout_toEndOf="@id/market_valu"
            android:layout_marginStart="@dimen/dp_15"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/separator_1"
            android:layout_marginTop="@dimen/dp_6"
            />

        <TextView
            android:id="@+id/avg_buy_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/avg_buy_value"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/avg_buy"
            android:layout_alignStart="@id/avg_buy"
            />

        <TextView
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:layout_toEndOf="@id/avg_buy"
            android:layout_marginStart="@dimen/dp_15"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/separator_1"
            android:layout_marginTop="@dimen/dp_6"
            />

        <TextView
            android:id="@+id/share_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_value"
            android:textAppearance="@style/total_cost_"
            android:layout_below="@id/share"
            android:layout_alignStart="@id/share"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/separator_2"
            android:layout_height="@dimen/dp_1"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_below="@id/total_cost_value"
            android:background="#E2E2E9"/>

        <TextView
            android:id="@+id/days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/dp_4"
            android:textFontWeight="400"
            android:layout_below="@id/separator_2"
            android:text="@string/day_s_p_l"
            android:textAppearance="@style/day_s_p_l"
            />

        <TextView
            android:id="@+id/days_p_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/dp_4"
            android:textFontWeight="600"
            android:layout_below="@id/days"
            android:text="10,000"
            android:textAppearance="@style/days_p_l"
            />

        <TextView
            android:id="@+id/days_percent_p_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginTop="@dimen/dp_4"
            android:textFontWeight="600"
            android:layout_below="@id/days_p_l"
            android:layout_alignStart="@id/days_p_l"
            android:text="(100%)"
            android:textAppearance="@style/days_percent_p_l"
            />



        <TextView
            android:id="@+id/total_p_l_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/days"
            android:layout_marginStart="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_4"
            android:textFontWeight="400"
            android:layout_below="@id/separator_2"
            android:text="@string/total_p_l_title"
            android:textAppearance="@style/day_s_p_l"
            />

        <TextView
            android:id="@+id/total_p_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/days"
            android:layout_alignStart="@id/total_p_l_title"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_toEndOf="@id/days"
            android:layout_toStartOf="@id/three_dots"
            android:text="10,0000"
            android:textAppearance="@style/days_p_l"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/total_percent_p_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginTop="@dimen/dp_4"
            android:textFontWeight="600"
            android:layout_below="@id/total_p_l"
            android:layout_alignStart="@id/total_p_l"
            android:text="(100%)"
            android:textAppearance="@style/days_percent_p_l"
            />


            <ImageView
                android:layout_width="@dimen/dp_35"
                android:layout_height="@dimen/dp_35"
                android:id="@+id/three_dots"
                android:padding="@dimen/dp_10"
                android:layout_marginHorizontal="@dimen/dp_2"
                android:src="@drawable/three_dots"
                android:layout_toStartOf="@id/snapshot_logo"
                android:layout_alignTop="@id/total_p_l"
       />


        <ImageView
            android:id="@+id/snapshot_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/three_dots"
            android:layout_alignBottom="@id/three_dots"
            android:layout_toStartOf="@id/btn_sell"
            style="@style/snapshot_logo"
            app:srcCompat="@drawable/snapshot_logo" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_35"
            android:id="@+id/btn_sell"
            android:text="Sell"
            android:textSize="12sp"
            android:textAppearance="@style/btn_sell"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="@id/snapshot_logo"
            android:layout_alignBottom="@id/snapshot_logo" />
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>