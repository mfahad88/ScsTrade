<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Main Scrollable Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.example.scstrade.views.widgets.mMarket
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            tools:context=".views.portfolio.activities.MyPortfolioActivity">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/mainLayout">

                <ProgressBar
                    android:id="@+id/loader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.example.scstrade.views.widgets.MarketValueView
                    android:id="@+id/current_market"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/portfolio_cost"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:mv_title="@string/current_mar"
                    app:mv_value="578,914" />

                <com.example.scstrade.views.widgets.MarketValueView
                    android:id="@+id/portfolio_cost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/current_market"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:mv_title="@string/portfolio_cost"
                    app:mv_value="578,914" />

                <com.example.scstrade.views.widgets.MarketValueView
                    android:id="@+id/day_s_p_l_holding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="4dp"
                    app:isColor_Enabled="true"
                    app:layout_constraintTop_toBottomOf="@id/current_market"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/total_p_l_holding"
                    app:layout_constraintHorizontal_weight="1"
                    app:mv_title="@string/day_s_p_l_holding"
                    app:mv_value="578,914" />

                <com.example.scstrade.views.widgets.MarketValueView
                    android:id="@+id/total_p_l_holding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    app:isColor_Enabled="true"
                    app:layout_constraintTop_toTopOf="@id/day_s_p_l_holding"
                    app:layout_constraintStart_toEndOf="@id/day_s_p_l_holding"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:mv_title="@string/total_p_l_holding"
                    app:mv_value="-578,914" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/holding_sha"
                    android:textAppearance="@style/holding_sha"
                    android:textFontWeight="700"
                    app:layout_constraintTop_toBottomOf="@id/day_s_p_l_holding"
                    app:layout_constraintStart_toStartOf="@id/day_s_p_l_holding" />

                <TextView
                    android:id="@+id/subTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/sub_title"
                    android:textAppearance="@style/sub_title"
                    android:textFontWeight="400"
                    app:layout_constraintTop_toTopOf="@id/title"
                    app:layout_constraintStart_toEndOf="@id/title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_15"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_my_portfolio_holding" />

                <TextView
                    android:id="@+id/titleHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/history"
                    android:textAppearance="@style/holding_sha"
                    android:textFontWeight="700"
                    app:layout_constraintTop_toBottomOf="@id/recyclerView"
                    app:layout_constraintStart_toStartOf="@id/title" />

                <TextView
                    android:id="@+id/subTitleHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="(1 year sold &amp; dividend)"
                    android:textAppearance="@style/sub_title"
                    android:textFontWeight="400"
                    app:layout_constraintTop_toTopOf="@id/titleHistory"
                    app:layout_constraintBottom_toBottomOf="@id/titleHistory"
                    app:layout_constraintStart_toEndOf="@id/title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHistory"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_15"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/titleHistory"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_my_portfolio_history" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:constraint_referenced_ids="title,subTitle,current_market,portfolio_cost,day_s_p_l_holding,total_p_l_holding,recyclerView"
                    tools:visibility="visible" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:constraint_referenced_ids="titleHistory,subTitleHistory,recyclerViewHistory"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Floating Menu Above FAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_menu"
        android:layout_width="@dimen/dp_146"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardElevation="@dimen/dp_2"
        app:strokeWidth="@dimen/dp_0"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="@dimen/dp_10">

            <TextView
                android:id="@+id/new_buy_trade"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/new_buy_trade"
                android:textAppearance="@style/new_buy_trade"
                android:textFontWeight="500" />

            <TextView
                android:id="@+id/sell_trade"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/sell_trade"
                android:textAppearance="@style/new_buy_trade"
                android:textFontWeight="500"
                android:visibility="visible" />

            <TextView
                android:id="@+id/add_dividend"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/add_dividend"
                android:textAppearance="@style/new_buy_trade"
                android:textFontWeight="500" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sticky Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        style="@style/CustomFloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:contentDescription="Add to watchlist"
        app:srcCompat="@drawable/baseline_add_24" />
</FrameLayout>
