<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="15dp"
        tools:context=".views.aof.fragments.kyc.nomineeDetail.KycNomineeDetailOneFragment">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"
            tools:visibility="visible"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/load_anim" />
        <TextView
            android:id="@+id/tell_us_abo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:gravity="top"
            android:lineSpacingExtra="3sp"
            android:text="@string/please_prov_nominee"
            android:textAppearance="@style/tell_us_abo"
            android:textFontWeight="500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.example.scstrade.views.widgets.DualOptionToggleView
            android:id="@+id/nominee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tell_us_abo"
            app:titleButton1="No"
            app:titleButton2="Yes"
            app:titleDualOption="@string/do_you_have_a_nominee" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            tools:visibility="visible"
            android:visibility="gone"
            android:id="@+id/nominee_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nominee">

            <com.example.scstrade.views.widgets.LabelledSpinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/nominee_relation"
                app:hintLabel="@string/nominee_relation"
                app:dropdownLabel="@string/spouse"/>

            <com.example.scstrade.views.widgets.LabelledTextField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/nominee_name"
                android:maxLength="30"
                android:inputType="textPersonName"
                app:hintText="@string/nominee_name"
                app:hintTextField="@string/enter_nominee_name"/>

            <com.example.scstrade.views.widgets.LabelledTextField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/nominee_mobile"
                android:maxLength="14"
                android:inputType="number"
                app:hintText="@string/mobile_number"
                app:hintTextField="@string/enter_your_mobile_number"/>

            <com.example.scstrade.views.widgets.LabelledSpinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/uin_type"
                app:hintLabel="@string/uin_type"
                app:dropdownLabel="@string/cnic"/>

            <com.example.scstrade.views.widgets.LabelledTextField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/uin_number"
                android:maxLength="14"
                android:inputType="number"
                app:hintText="@string/uin"
                app:hintTextField="@string/enter_uin_number"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nominee_view"
            app:layout_constraintVertical_bias="0.94">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="0.8"
                android:text="Back" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="0.8"
                android:text="Continue" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>