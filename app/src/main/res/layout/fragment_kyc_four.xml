<?xml version="1.0" encoding="utf-8"?>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_15">

    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/md_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_8"
        android:fillViewport="true"
        android:paddingBottom="@dimen/dp_10"
        android:fadingEdge="vertical"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_50"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical">

            <TextView
                android:id="@+id/tell_us_abo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_23"
                android:gravity="top"
                android:lineSpacingExtra="3sp"
                android:text="@string/tell_us_abo_contact"
                android:textAppearance="@style/tell_us_abo"
                android:textFontWeight="500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.example.scstrade.views.widgets.LabelledTextField
                android:id="@+id/mobile_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@color/md_theme_surfaceBright"
                android:digits="@string/_0_9"
                android:inputType="number"
                android:text="03143966681"
                app:hintText="Mobile Number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tell_us_abo" />

            <com.example.scstrade.views.widgets.LabelledTextField
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@color/md_theme_surfaceBright"
                android:inputType="textEmailAddress"
                android:text="Test@mailinator.com"
                app:hintText="Email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mobile_number" />

            <EditText
                android:id="@+id/mailing_address_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@drawable/drawable_text_border"
                android:gravity="top"
                android:digits="@string/alphanumeric"
                android:hint="@string/enter_your_"
                android:inputType="text|textMultiLine"
                android:maxLength="40"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/email" />


            <EditText
                android:id="@+id/mailing_address_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@drawable/drawable_text_border"
                android:gravity="top"
                android:hint="@string/enter_your_"
                android:digits="@string/alphanumeric"
                android:inputType="text|textMultiLine"
                android:maxLength="40"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_address_1" />

            <EditText
                android:id="@+id/mailing_address_3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@drawable/drawable_text_border"
                android:gravity="top"
                android:hint="@string/enter_your_"
                android:inputType="text|textMultiLine"
                android:maxLength="40"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_address_2" />


            <com.example.scstrade.views.widgets.CountyDropDown
                android:id="@+id/mailing_country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:dropdownLabel="@string/select_your_mailing_country"
                app:hintLabel="@string/mailing_country"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_address_3" />

            <com.example.scstrade.views.widgets.LabelledSpinner
                android:id="@+id/mailing_province"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:dropdownLabel="@string/select_your_province"
                app:hintLabel="@string/mailing_province"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_country" />

            <com.example.scstrade.views.widgets.LabelledTextField
                android:id="@+id/mailing_other_province"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:maxLines="1"
                android:visibility="gone"
                android:inputType="text"
                android:maxLength="50"
                app:hintText="@string/mailing_province"
                app:hintTextField="@string/select_your_province"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_country" />

            <com.example.scstrade.views.widgets.CityDropDown
                android:id="@+id/mailing_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:dropdownLabel="@string/select_your_city"
                app:hintLabel="@string/mailing_city"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_province" />


            <com.example.scstrade.views.widgets.LabelledTextField
                android:id="@+id/mailing_other_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:maxLines="1"
                android:inputType="text"
                android:maxLength="50"
                android:visibility="gone"
                app:hintText="@string/mailing_city"
                app:hintTextField="@string/select_your_city"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_province"
                app:layout_constraintVertical_bias="0.0" />


            <com.example.scstrade.views.widgets.DualDropdownSelectorView
                android:id="@+id/office_residence_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:hintDualDropdown1="@string/enter_your_office"
                app:hintDualDropdown2="Enter your Residence Number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mailing_other_city"
                app:titleDualDropdown="@string/kindly_ente"
                app:typeDualDropdown1="text"
                app:typeDualDropdown2="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:textFontWeight="500"
                    android:textAppearance="@style/click_to_fill"
                    android:text="@string/click_to_fill"/>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    app:cornerRadius="@dimen/dp_7"
                    android:id="@+id/btn_copy"
                    app:backgroundTint="#3b82f6"
                    android:layout_weight="0.5"
                    android:text="Copy"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/no_worries"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_115"
                android:layout_marginTop="@dimen/dp_15"
                app:cardBackgroundColor="@color/md_theme_surfaceBright"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/parmanent_addr_option"
                app:strokeColor="#1A73E8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_15">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/icon_no_worries" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_12"
                            android:text="@string/no_worries_"
                            android:textAppearance="@style/no_worries_"
                            android:textFontWeight="600" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/please_tap_"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_30"
                        android:paddingEnd="@dimen/dp_90"
                        android:text="@string/please_tap_"
                        android:textAppearance="@style/please_tap_"
                        android:textFontWeight="400"

                        />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/layoutPermanent"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/parmanent_addr_1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/drawable_text_border"
                    android:gravity="top"
                    android:hint="@string/enter_your_parmanent"
                    android:inputType="text|textMultiLine"
                    android:maxLength="40"
                    android:padding="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/no_worries" />

                <EditText
                    android:id="@+id/parmanent_addr_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/drawable_text_border"
                    android:gravity="top"
                    android:hint="@string/enter_your_parmanent"
                    android:inputType="text|textMultiLine"
                    android:maxLength="40"
                    android:padding="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/parmanent_addr_1" />

                <EditText
                    android:id="@+id/parmanent_addr_3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/drawable_text_border"
                    android:gravity="top"
                    android:hint="@string/enter_your_parmanent"
                    android:inputType="text|textMultiLine"
                    android:maxLength="40"
                    android:padding="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/parmanent_addr_3" />


                <com.example.scstrade.views.widgets.CountyDropDown
                    android:id="@+id/permanent_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    app:dropdownLabel="@string/select_your_permanent_country"
                    app:hintLabel="@string/permanent_country"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/parmanent_addr_3" />


                <com.example.scstrade.views.widgets.LabelledSpinner
                    android:id="@+id/permanent_province"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    app:dropdownLabel="@string/select_your_permanent_province"
                    app:hintLabel="@string/permanent_province"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/permanent_country" />

                <com.example.scstrade.views.widgets.LabelledTextField
                    android:id="@+id/permanent_other_province"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:maxLength="20"
                    android:inputType="text"
                    android:visibility="gone"
                    app:hintText="@string/permanent_province"
                    app:hintTextField="@string/select_your_permanent_province"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/permanent_country" />

                <com.example.scstrade.views.widgets.CityDropDown
                    android:id="@+id/permanent_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    app:dropdownLabel="@string/select_your_city"
                    app:hintLabel="@string/permanent_city"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/permanent_province" />

                <com.example.scstrade.views.widgets.LabelledTextField
                    android:id="@+id/permanent_other_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:maxLength="20"
                    android:inputType="text"
                    android:visibility="gone"
                    app:hintText="@string/permanent_city"
                    app:hintTextField="@string/select_your_city"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/permanent_province" />

                <com.example.scstrade.views.widgets.DualDropdownSelectorView
                    android:id="@+id/phone_numbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_16"
                    app:hintDualDropdown1="@string/enter_your_office"
                    app:hintDualDropdown2="@string/residence_number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/permanent_city"
                    app:titleDualDropdown="@string/kindly_ente"
                    app:typeDualDropdown1="text"
                    app:typeDualDropdown2="text" />


            </LinearLayout>

            <!--<androidx.constraintlayout.widget.Group
                android:id="@+id/groupPermanent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/no_worries"
                android:visibility="visible"
                app:constraint_referenced_ids="parmanent_addr_1,parmanent_addr_2,parmanent_addr_3,permanent_country,permanent_province,permanent_other_province,permanent_city,permanent_other_city,phone_numbers" />-->


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/linearLayout9"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_55"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_50"
                android:layout_weight="0.8"
                android:text="Back" />

            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="0.2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_50"
                android:layout_weight="0.8"
                android:text="Continue" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

