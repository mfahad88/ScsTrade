<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:strokeWidth="@dimen/dp_0"
    app:cardCornerRadius="@dimen/dp_12">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surfaceBright"
        android:paddingHorizontal="@dimen/dp_15"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_20">

        <TextView
            android:id="@+id/select_your"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            tools:text="@string/select_your"
            android:textAppearance="@style/select_your"
            android:textFontWeight="500" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/select_your"
            android:id="@+id/sub_heading"
            android:textFontWeight="500"
            android:paddingEnd="@dimen/dp_100"
            android:textAppearance="@style/do_you_wish"
            tools:text="@string/do_you_wish"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_below="@id/sub_heading"
            android:layout_marginTop="@dimen/dp_12"
            android:id="@+id/linearButton"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:weightSum="1">

            <RelativeLayout
                android:id="@+id/btn_single"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:background="@drawable/drawable_toggle">

                <TextView
                    android:id="@+id/text1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    tools:text="Single"
                    android:textAppearance="@style/single_btn" />

            </RelativeLayout>

            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="0.1" />

            <RelativeLayout
                android:id="@+id/btn_married"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"

                android:layout_weight="0.4"
                android:background="@drawable/drawable_toggle">

                <TextView
                    android:id="@+id/text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    tools:text="Married"
                    android:textAppearance="@style/single_btn" />

            </RelativeLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/dp_4"
            app:cardElevation="@dimen/dp_0"
            android:id="@+id/textField"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="@color/md_theme_outline"
            android:layout_below="@id/linearButton">

            <RelativeLayout
                android:layout_width="match_parent"
                android:background="@color/md_theme_surfaceContainerLowest_highContrast"
                android:layout_height="@dimen/dp_48">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/imageView"
                    android:id="@+id/editText"
                    android:paddingHorizontal="@dimen/dp_10"
                    tools:hint="Please select"
                    android:background="@android:color/transparent" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:paddingEnd="@dimen/dp_15"
                    app:srcCompat="@drawable/baseline_calendar_today_24" />


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>