<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surfaceContainerLowest"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="@dimen/dp_15"
    tools:context=".views.aof.fragments.kyc.attorneyDetail.KycAttorneyDetailOneFragment">
    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/md_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
   <androidx.core.widget.NestedScrollView
       android:layout_width="@dimen/dp_0"
       android:layout_height="@dimen/dp_0"
       android:fillViewport="true"
       android:scrollbars="vertical"
       android:paddingBottom="@dimen/dp_10"
       android:fadingEdge="vertical"
       android:requiresFadingEdge="vertical"
       android:fadingEdgeLength="@dimen/dp_50"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintBottom_toTopOf="@id/controls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tell_us_abo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_23"
                android:gravity="top"
                android:lineSpacingExtra="3sp"
                android:text="@string/please_prov"
                android:textAppearance="@style/tell_us_abo"
                android:textFontWeight="500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.example.scstrade.views.widgets.DualOptionToggleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/is_the_atto"
                android:layout_marginTop="@dimen/dp_15"
                app:titleDualOption="@string/is_the_attorney_yourself_or_someone_else"
                app:titleButton1="@string/self"
                app:titleButton2="@string/someone_else"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tell_us_abo" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:id="@+id/some_else_container"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/is_the_atto">

                <com.example.scstrade.views.widgets.LabelledSpinner
                    android:id="@+id/labelledSpinner"
                    android:layout_width="@dimen/dp_95"
                    android:layout_height="wrap_content"
                    app:dropdownLabel="Mr."
                    app:hintLabel=""
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.example.scstrade.views.widgets.LabelledTextField
                    android:id="@+id/fullName"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:layout_marginStart="@dimen/dp_10"
                    android:inputType="text"
                    android:maxLength="50"
                    app:hintText="@string/full_name"
                    app:hintTextField="@string/enter_fname_nic"
                    app:layout_constraintBottom_toBottomOf="@+id/labelledSpinner"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/labelledSpinner"
                    app:layout_constraintTop_toTopOf="@+id/labelledSpinner" />

                <com.example.scstrade.views.widgets.LabelledSpinner
                    android:id="@+id/uin_type"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    app:dropdownLabel="@string/cnic"
                    app:hintLabel="@string/uin_type"
                    android:layout_marginTop="@dimen/dp_15"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fullName" />

                <com.example.scstrade.views.widgets.LabelledTextField
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:inputType="number"
                    android:maxLength="20"
                    app:hintText="@string/uin"
                    android:id="@+id/uin_number"
                    app:hintTextField="@string/enter_your_uin_number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/uin_type"/>

                <com.example.scstrade.views.widgets.DualOptionToggleView
                    android:id="@+id/is_attorney"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    app:drawable="@drawable/baseline_calendar_today_24"
                    app:hintDualOption="@string/select_nic_expiry_date"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/uin_number"
                    app:titleButton1="No"
                    app:titleButton2="Yes"
                    app:titleDualOption="@string/is_attorney" />


                <com.example.scstrade.views.widgets.LabelledTextField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/mobile_number"
                    android:inputType="phone"
                    android:maxLength="12"
                    app:hintText="@string/mobile_number"
                    app:hintTextField="@string/enter_your_mobile_number"
                    app:infoText="@string/supporting_"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/is_attorney" />


                <com.example.scstrade.views.widgets.LabelledTextField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/email_addr"
                    app:hintText="@string/email"
                    android:inputType="textEmailAddress"
                    android:maxLength="30"
                    app:hintTextField="@string/enter_your_email"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mobile_number" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/mailing_address_1"
                    android:inputType="text|textMultiLine"
                    android:padding="@dimen/dp_10"
                    android:gravity="top"
                    android:hint="@string/enter_your_mailing_address"
                    android:background="@drawable/drawable_text_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/email_addr"/>


                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/mailing_address_2"
                    android:inputType="text|textMultiLine"
                    android:padding="@dimen/dp_10"
                    android:gravity="top"
                    android:hint="@string/enter_your_mailing_address"
                    android:background="@drawable/drawable_text_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mailing_address_1"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/mailing_address_3"
                    android:inputType="text|textMultiLine"
                    android:padding="@dimen/dp_10"
                    android:gravity="top"
                    android:hint="@string/enter_your_mailing_address"
                    android:background="@drawable/drawable_text_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mailing_address_2"/>

                <com.example.scstrade.views.widgets.LabelledTextField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/residence_number"
                    android:inputType="phone"
                    android:maxLength="30"
                    app:hintText="@string/residence_num"
                    app:hintTextField="@string/residence_number"
                    app:infoText="@string/supporting_"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mailing_address_3" />


                <com.example.scstrade.views.widgets.CountyDropDown
                    android:id="@+id/attorney_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    app:dropdownLabel="@string/select_your_country"
                    app:hintLabel="@string/attorney_country"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/residence_number" />

                <com.example.scstrade.views.widgets.LabelledSpinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/attorney_province"
                    app:hintLabel="@string/attorney_province"
                    app:dropdownLabel="@string/select_your_province"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/attorney_country"/>

                <com.example.scstrade.views.widgets.LabelledTextField
                    android:id="@+id/attorney_other_province"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:inputType="text"
                    android:maxLength="50"
                    app:hintText="@string/attorney_province"
                    app:hintTextField="@string/select_your_province"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/attorney_country" />

                <com.example.scstrade.views.widgets.CityDropDown
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:id="@+id/attorney_city"
                    app:hintLabel="@string/attorney_city"
                    app:dropdownLabel="@string/select_your_city"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/attorney_province"/>


                <com.example.scstrade.views.widgets.LabelledTextField
                    android:id="@+id/attorney_other_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:inputType="text"
                    android:maxLength="50"
                    app:hintText="@string/attorney_city"
                    app:hintTextField="@string/select_your_city"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/attorney_province" />
            </androidx.constraintlayout.widget.ConstraintLayout>



        </LinearLayout>
   </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_55"
        android:orientation="horizontal"
        android:weightSum="2"
        android:id="@+id/controls"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Back"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="0.2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Continue" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>