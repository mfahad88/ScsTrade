<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/trading_signal"
        android:text="@string/scs_trading_signal_system"
        android:textAppearance="@style/scs_trading_signal_system"
        android:textFontWeight="700"
        android:paddingHorizontal="10dp"
        android:visibility="gone"
        android:paddingVertical="4dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2.4"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:textFontWeight="500"
            android:textAlignment="textStart"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:text="@string/cash"
            android:textAppearance="@style/cash"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            />
        <TextView
            android:id="@+id/value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textFontWeight="500"
            android:textAlignment="textEnd"
            android:gravity="end|center_vertical"
            android:layout_gravity="center_vertical"
            android:text="cash"
            android:textAppearance="@style/cash"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="horizontal"
        android:id="@+id/divider"
        android:background="@color/md_theme_surfaceContainerHighest"/>


</LinearLayout>