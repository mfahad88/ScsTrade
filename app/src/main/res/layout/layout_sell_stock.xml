<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/dp_10"
    android:layout_marginStart="@dimen/dp_15"
    android:layout_marginTop="@dimen/dp_4"
    android:layout_marginEnd="@dimen/dp_15"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/toolbar">

    <TextView
        android:id="@+id/buy_stocks_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sell_stocks"
        android:textAppearance="@style/buy_stocks_"
        android:textFontWeight="700"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/invest_in_s"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/easily_sell"
        android:textAppearance="@style/invest_in_s"
        android:textFontWeight="400"
        android:translationY="-1.38sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_stocks_" />

    <RelativeLayout
        android:id="@+id/relative_symbol"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/invest_in_s">

        <AutoCompleteTextView
            android:id="@+id/symbol"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:drawableEnd="@drawable/search_gray"
            android:hint="Enter symbol"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:singleLine="true" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_share"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_4"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toStartOf="@+id/relative_buy_price"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/relative_symbol">

        <EditText
            android:id="@+id/shares"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:digits="@string/_0_9"
            android:hint="Enter shares"
            android:inputType="number"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:singleLine="true" />
    </RelativeLayout>

    <TextView
        android:id="@+id/available_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:gravity="center_vertical"
        android:lineSpacingExtra="7sp"
        android:text="@string/available_share"
        android:textAppearance="@style/available_share"
        android:textFontWeight="700"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relative_share" />

    <TextView
        android:id="@+id/available_share_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_2"
        android:layout_marginTop="@dimen/dp_3"
        android:gravity="center_vertical"
        android:lineSpacingExtra="7sp"
        android:text="1000"
        android:textAppearance="@style/available_share"
        android:textFontWeight="700"
        app:layout_constraintStart_toEndOf="@+id/available_share"
        app:layout_constraintTop_toBottomOf="@+id/relative_share" />

    <RelativeLayout
        android:id="@+id/relative_buy_price"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_56"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/relative_share"
        app:layout_constraintTop_toBottomOf="@id/relative_symbol">

        <EditText
            android:id="@+id/buy_price"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:digits="@string/_0_9_decimal"
            android:hint="Enter Buy Price"
            android:inputType="numberDecimal"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:singleLine="true" />
    </RelativeLayout>


    <TextView
        android:id="@+id/avg_buy_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:gravity="center_vertical"
        android:lineSpacingExtra="7sp"
        android:text="@string/avg_buy_price"
        android:textAppearance="@style/available_share"
        android:textFontWeight="700"
        app:layout_constraintStart_toStartOf="@+id/relative_buy_price"
        app:layout_constraintTop_toBottomOf="@+id/relative_share" />

    <TextView
        android:id="@+id/avg_buy_price_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_2"
        android:layout_marginTop="@dimen/dp_3"
        android:gravity="center_vertical"
        android:lineSpacingExtra="7sp"
        android:text="202.57"
        android:textAppearance="@style/available_share"
        android:textFontWeight="700"
        app:layout_constraintStart_toEndOf="@+id/avg_buy_price"
        app:layout_constraintTop_toBottomOf="@+id/relative_share" />

    <RelativeLayout
        android:id="@+id/relative_comission"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="@+id/relative_share"
        app:layout_constraintStart_toStartOf="@+id/relative_share"
        app:layout_constraintTop_toBottomOf="@+id/available_share">

        <EditText
            android:id="@+id/comission_share"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:digits="@string/_0_9_decimal"
            android:hint="Commission Per Share"
            android:inputType="numberDecimal"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:singleLine="true" />
    </RelativeLayout>

    <TextView
        android:id="@+id/input_text"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_24"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:lineSpacingExtra="7sp"
        android:textFontWeight="500"
        android:text="@string/input_text"
        android:textAppearance="@style/input_text"
        app:layout_constraintStart_toStartOf="@+id/relative_buy_price"
        app:layout_constraintTop_toTopOf="@+id/relative_comission" />

    <RadioGroup
        android:id="@+id/radioCommissionType"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_1"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/relative_comission"
        app:layout_constraintStart_toStartOf="@+id/input_text"
        app:layout_constraintTop_toBottomOf="@+id/input_text">

        <RadioButton
            android:id="@+id/radioShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Rs/Share"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/radioVar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Var %"
            android:textSize="12sp" />
    </RadioGroup>


    <RelativeLayout
        android:id="@+id/relative_date"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/relative_share"
        app:layout_constraintTop_toBottomOf="@+id/relative_comission">

        <EditText
            android:id="@+id/purchase_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Select Purchase Date"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="@dimen/dp_10"
            android:singleLine="true" />
    </RelativeLayout>
    <Button
        android:id="@+id/buttonSell"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_24"
        android:text="Sell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>