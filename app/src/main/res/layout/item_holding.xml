<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="@color/md_theme_surface"
    android:weightSum="4">

    <!-- Buy Date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buy Date"
            style="@style/TradeLabel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/buy_date"
            android:text="Apr 8, 2024"
            style="@style/TradeValue.Bold" />
    </LinearLayout>

    <!-- Shares -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shares"
            style="@style/TradeLabel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/shares"
            android:text="1,000"
            style="@style/TradeValue.Bold" />
    </LinearLayout>

    <!-- Current P/L -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current P/L"
            style="@style/TradeLabel" />

        <com.example.scstrade.views.widgets.ColoredValueTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/current_pl"
            android:textFontWeight="700"
            android:text="14,490"
            style="@style/TradeValue.Profit" />

        <com.example.scstrade.views.widgets.ColoredValueTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/current_pl_percent"
            android:text="(6.86%)"
            style="@style/TradePercent.Profit" />
    </LinearLayout>

    <!-- Net Price + Cost -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Net Price"
            style="@style/TradeLabel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/net_price"
            android:text="211.25"
            style="@style/TradeValue.Bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Net Cost"
            style="@style/TradeLabel"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/net_cost"
            android:text="211,250"
            style="@style/TradeValue.Bold" />
    </LinearLayout>

</LinearLayout>

