<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.portfolio.PortfolioDetailActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        app:cardBackgroundColor="@color/md_theme_surfaceBright"
        app:layout_constraintEnd_toStartOf="@+id/card_compan"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/current_mar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_mar"
                android:textAppearance="@style/current_mar" />

            <TextView
                android:id="@+id/current_mar_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_mar_value"
                android:textAppearance="@style/current_mar_value"
                android:textFontWeight="600" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_compan"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        app:cardBackgroundColor="@color/md_theme_surfaceBright"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/card_mar"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/total_compa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_compa"
                android:textAppearance="@style/current_mar" />

            <TextView
                android:id="@+id/total_compa_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_mar_value"
                android:textAppearance="@style/current_mar_value"
                android:textFontWeight="600" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="@+id/card_compan"
        app:layout_constraintStart_toStartOf="@+id/card_mar"
        app:layout_constraintTop_toBottomOf="@+id/card_mar" />
</androidx.constraintlayout.widget.ConstraintLayout>