<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/md_theme_surface"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <com.example.scstrade.views.widgets.mMarket
        android:id="@+id/toolbar"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
                android:id="@+id/loader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/md_theme_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_theme_surface"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            tools:context=".views.portfolio.activities.PortfolioDetailActivity"
            tools:visibility="visible">


            <com.example.scstrade.views.widgets.GrayCardView
                android:id="@+id/card_mar"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_4"
                android:text="@string/current_mar_value"
                app:cardElevation="@dimen/dp_2"
                app:layout_constraintEnd_toStartOf="@+id/card_compan"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="@dimen/dp_0"
                app:titleGrayView="@string/current_mar" />

            <com.example.scstrade.views.widgets.GrayCardView
                android:id="@+id/card_compan"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_10"
                android:text="@string/current_mar_value"
                app:cardElevation="@dimen/dp_2"
                app:layout_constraintBottom_toBottomOf="@+id/card_mar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/card_mar"

                app:layout_constraintTop_toTopOf="@+id/card_mar"
                app:strokeWidth="@dimen/dp_0"
                app:titleGrayView="@string/total_compa" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/p_l_card"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:cardElevation="@dimen/dp_2"
                app:layout_constraintEnd_toEndOf="@+id/card_compan"
                app:layout_constraintStart_toStartOf="@+id/card_mar"
                app:layout_constraintTop_toBottomOf="@+id/card_mar"
                app:strokeWidth="@dimen/dp_0">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/md_theme_surfaceBright"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_7">

                    <TextView
                        android:id="@+id/p_l_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:text="@string/p_l_summary"
                        android:textAppearance="@style/p_l_summary"
                        android:textFontWeight="600" />

                    <RelativeLayout
                        android:id="@+id/view_detail"
                        android:layout_width="@dimen/dp_103"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/circular_drop_down"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/view_det"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/view_det"

                            android:textAppearance="@style/view_det" />

                        <ImageView
                            android:layout_width="@dimen/dp_8"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_3"
                            android:layout_toEndOf="@id/view_det"
                            android:src="@drawable/drop_down"
                            app:tint="@color/colorDarkerr" />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/holdings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/p_l_summary"
                        android:layout_marginTop="@dimen/dp_8"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="@dimen/dp_59"
                            android:layout_gravity="start"
                            android:layout_weight="0.975"
                            app:cardBackgroundColor="@color/portfolio_green"
                            app:strokeColor="@color/md_theme_primary">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/days_p_l_ho"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="@dimen/dp_5"
                                    android:text="@string/days_p_l_ho"
                                    android:textAppearance="@style/days_p_l_ho"
                                    android:textFontWeight="400" />

                                <TextView
                                    android:id="@+id/days_p_l_ho_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:gravity="center_horizontal|top"
                                    android:textAppearance="@style/days_p_l_ho_value"
                                    android:textFontWeight="600"
                                    tools:text="@string/days_p_l_ho_value" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.05" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="@dimen/dp_59"
                            android:layout_gravity="end"
                            android:layout_weight="0.975"
                            app:cardBackgroundColor="@color/portfolio_green"
                            app:strokeColor="@color/md_theme_primary">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/total_p_l_h"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="@dimen/dp_5"
                                    android:text="@string/total_p_l_h"
                                    android:textAppearance="@style/days_p_l_ho"
                                    android:textFontWeight="400" />

                                <TextView
                                    android:id="@+id/total_p_l_h_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:gravity="center_horizontal|top"
                                    android:textAppearance="@style/days_p_l_ho_value"
                                    android:textFontWeight="600"
                                    tools:text="@string/days_p_l_ho_value" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/summary_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/holdings"
                        android:layout_marginTop="@dimen/dp_10"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_45"
                                android:background="@color/colorDarkerr"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/dp_15"
                                android:weightSum="3">

                                <TextView
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/summary"
                                    android:textAppearance="@style/summary"
                                    android:textFontWeight="700" />

                                <TextView
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.6"
                                    android:text="@string/cost"
                                    android:textAppearance="@style/summary"
                                    android:textFontWeight="700" />

                                <TextView
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1.4"
                                    android:text="@string/p_l"
                                    android:textAppearance="@style/summary"
                                    android:textFontWeight="700" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_45"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/dp_15"
                                android:weightSum="3">

                                <TextView
                                    android:id="@+id/total"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/total"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500" />

                                <TextView
                                    android:id="@+id/total_cost"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.6"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500"
                                    tools:text="@string/total_cost" />

                                <TextView
                                    android:id="@+id/total_p_l"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_weight="1.4"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500"
                                    tools:text="@string/total_p_l" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_45"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/dp_15"
                                android:weightSum="3">

                                <TextView
                                    android:id="@+id/holding"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/holding"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500" />

                                <TextView
                                    android:id="@+id/holding_cost"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.6"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500"
                                    tools:text="@string/total_cost" />

                                <TextView
                                    android:id="@+id/holding_p_l"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_weight="1.4"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500"
                                    tools:text="@string/total_p_l" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_45"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/dp_15"
                                android:weightSum="3">

                                <TextView
                                    android:id="@+id/history"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/history"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500" />

                                <TextView
                                    android:id="@+id/history_cost"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.6"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500"
                                    tools:text="@string/history_cost" />

                                <TextView
                                    android:id="@+id/history_p_l"
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_weight="1.4"
                                    android:textAppearance="@style/total"
                                    android:textFontWeight="500"
                                    tools:text="@string/history_p_l" />
                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

           <!-- <LinearLayout
                android:id="@+id/linearLayout7"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/p_l_card"
                app:layout_constraintStart_toStartOf="@id/p_l_card"
                app:layout_constraintTop_toBottomOf="@id/p_l_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/holding"
                    android:textAppearance="@style/holding_sha"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:text="@string/share_in"
                    android:textAppearance="@style/share_in"
                    android:textFontWeight="400" />
            </LinearLayout>-->




            <LinearLayout
                android:id="@+id/linearLayoutHistory"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/p_l_card"
                app:layout_constraintStart_toStartOf="@id/p_l_card"
                app:layout_constraintTop_toBottomOf="@id/recyclerView">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history"
                    android:textAppearance="@style/holding_sha"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:text="@string/history_1_y"
                    android:textAppearance="@style/share_in"
                    android:textFontWeight="400" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistory"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_10"
                android:nestedScrollingEnabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayoutHistory"
                tools:itemCount="3"
                tools:listitem="@layout/item_1_year_history" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionButton"
                style="@style/CustomFloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_16"
                android:clickable="true"
                android:contentDescription="Add to watchlist"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:srcCompat="@drawable/baseline_add_24" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/floating_menu"
                android:layout_width="@dimen/dp_146"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_10"
                android:visibility="gone"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardElevation="@dimen/dp_2"
                app:layout_constraintBottom_toTopOf="@+id/floatingActionButton"
                app:layout_constraintEnd_toEndOf="@+id/floatingActionButton"
                app:strokeWidth="@dimen/dp_0"
                tools:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/dp_10">

                    <TextView
                        android:id="@+id/new_buy_trade"
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:lineSpacingExtra="3sp"
                        android:paddingVertical="@dimen/dp_5"
                        android:text="@string/new_buy_trade"
                        android:textAppearance="@style/new_buy_trade"
                        android:textFontWeight="500" />

                    <TextView
                        android:id="@+id/sell_trade"
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:lineSpacingExtra="3sp"
                        android:paddingVertical="@dimen/dp_5"
                        android:text="@string/sell_trade"
                        android:textAppearance="@style/new_buy_trade"
                        android:textFontWeight="500"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/add_dividend"
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:lineSpacingExtra="3sp"
                        android:paddingVertical="@dimen/dp_5"
                        android:text="@string/add_dividend"
                        android:textAppearance="@style/new_buy_trade"
                        android:textFontWeight="500" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupHolding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="recyclerView,linearLayout7"
                tools:visibility="visible" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="linearLayoutHistory,recyclerHistory" />

         <LinearLayout
             android:layout_width="@dimen/dp_0"
             android:layout_height="wrap_content"
             android:orientation="vertical"
             android:id="@+id/linearEmpty"
             app:layout_constraintBottom_toBottomOf="parent"
             app:layout_constraintEnd_toEndOf="@+id/p_l_card"
             app:layout_constraintStart_toStartOf="@+id/p_l_card"
             app:layout_constraintTop_toBottomOf="@+id/p_l_card">

             <ImageView
                 android:id="@+id/imageView34"
                 android:layout_width="@dimen/dp_150"
                 android:layout_height="@dimen/dp_166"
                 android:layout_gravity="center_horizontal"
                 app:srcCompat="@drawable/empty_holding" />

             <TextView
                 android:id="@+id/textView5"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/dp_4"
                 android:layout_gravity="center_horizontal"
                 android:text="@string/holding_are"
                 android:textAppearance="@style/holding_are"
                 android:textFontWeight="500"
                 app:layout_constraintEnd_toEndOf="@+id/p_l_card"
                 app:layout_constraintStart_toStartOf="@+id/p_l_card"
                 app:layout_constraintTop_toBottomOf="@+id/imageView34" />

             <TextView
                 android:id="@+id/add_share_t"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:lineSpacingExtra="14sp"
                 android:layout_gravity="center_horizontal"
                 android:text="@string/add_share_t"
                 android:textAppearance="@style/add_share_t"
                 app:layout_constraintEnd_toEndOf="@+id/p_l_card"
                 app:layout_constraintStart_toStartOf="@+id/p_l_card"
                 app:layout_constraintTop_toBottomOf="@+id/textView5" />
         </LinearLayout>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupEmptyHolding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="linearEmpty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/p_l_card"
                app:layout_constraintStart_toStartOf="@+id/p_l_card"
                app:layout_constraintTop_toBottomOf="@+id/p_l_card"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>