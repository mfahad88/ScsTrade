<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tell_us_abo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_19"
        android:layout_marginTop="@dimen/dp_23"
        android:gravity="top"
        android:lineSpacingExtra="3sp"
        android:text="@string/tell_us_abo_your_se"
        android:textAppearance="@style/tell_us_abo"
        android:textFontWeight="500"
        android:translationY="-1.4sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/fullName"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_20"
        android:inputType="text"
        android:maxLength="50"
        app:hintText="@string/full_name"
        app:hintTextField="@string/enter_your_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tell_us_abo" />


    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/emailAddress"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:inputType="text"
        android:maxLength="50"
        app:hintText="@string/email"
        app:hintTextField="@string/enter_your_email"
        app:layout_constraintEnd_toEndOf="@+id/fullName"
        app:layout_constraintStart_toStartOf="@+id/fullName"
        app:layout_constraintTop_toBottomOf="@+id/fullName" />

    <com.example.scstrade.views.widgets.DualOptionToggleView
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:titleDualOption="@string/residential"
        app:titleButton1="@string/resident"
        app:titleButton2="@string/non_resident"
        android:id="@+id/residential_status"
        app:layout_constraintEnd_toEndOf="@+id/emailAddress"
        app:layout_constraintStart_toStartOf="@+id/emailAddress"
        app:layout_constraintTop_toBottomOf="@+id/emailAddress">

    </com.example.scstrade.views.widgets.DualOptionToggleView>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputNic"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:hint="@string/nic_type"
        app:boxBackgroundMode="outline"
        app:expandedHintEnabled="false"
        app:layout_constraintEnd_toEndOf="@+id/residential_status"
        app:layout_constraintStart_toStartOf="@+id/residential_status"
        app:layout_constraintTop_toBottomOf="@+id/residential_status">

        <AutoCompleteTextView
            android:id="@+id/nic_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/select_your_nic_type"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/nic_card"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:inputType="number"
        android:maxLength="50"
        app:hintText="@string/nic_num"
        app:hintTextField="@string/enter_nic_num"
        app:layout_constraintEnd_toEndOf="@+id/fullName"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/fullName"
        app:layout_constraintTop_toBottomOf="@+id/textInputNic" />

    <TextView
        android:id="@+id/supporting_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_16"
        android:gravity="right|top"
        android:lineSpacingExtra="1sp"
        android:text="@string/supporting_"
        android:textAppearance="@style/supporting_"
        android:translationY="-0.74sp"
        app:layout_constraintEnd_toEndOf="@+id/nic_card"
        app:layout_constraintTop_toBottomOf="@+id/nic_card" />

    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/nic_issue_date"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:inputType="text"
        android:maxLength="50"
        app:hintText="@string/nic_issue_date"
        app:hintTextField="@string/enter_issue_date"
        android:drawableEnd="@drawable/baseline_calendar_today_24"
        app:layout_constraintEnd_toEndOf="@+id/fullName"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/fullName"
        app:layout_constraintTop_toBottomOf="@+id/supporting_" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_55"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nic_issue_date"
        app:layout_constraintVertical_bias="1.0">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Back" />

        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="0.2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Continue" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>