<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="15dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="15dp"
    android:paddingBottom="10dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/toolbar">

    <TextView
        android:id="@+id/buy_stocks_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_dividen"
        android:textAppearance="@style/buy_stocks_"
        android:textFontWeight="700"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/invest_in_s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/keep_track_"
        android:textAppearance="@style/invest_in_s"
        android:textFontWeight="400"
        android:translationY="-1.38sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_stocks_" />

    <RelativeLayout
        android:id="@+id/relative_symbol"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/invest_in_s">

        <AutoCompleteTextView
            android:id="@+id/symbol"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:completionThreshold="1"
            android:drawableEnd="@drawable/search_gray"
            android:hint="Enter symbol"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_share"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toStartOf="@+id/relative_dividend"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/relative_symbol">

        <EditText
            android:id="@+id/shares"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:digits="@string/_0_9"
            android:hint="Enter shares"
            android:inputType="number"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_dividend"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/relative_share"
        app:layout_constraintTop_toBottomOf="@id/relative_symbol">

        <EditText
            android:id="@+id/dividend_share"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:digits="@string/_0_9_decimal"
            android:hint="Dividend Per Share"
            android:inputType="numberDecimal"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true" />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/relative_date"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/relative_share"
        app:layout_constraintTop_toBottomOf="@+id/relative_share">

        <EditText
            android:id="@+id/dividend_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Select Dividend Date"
            android:lines="1"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true" />
    </RelativeLayout>

    <Button
        android:id="@+id/btnDividend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="Add Dividend"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>