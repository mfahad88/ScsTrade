<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="15dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".views.aof.fragments.kyc.KycOtherDetailTwoFragment">

    <com.example.scstrade.views.widgets.DualDropdownSelectorView
        android:id="@+id/job_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:titleDualDropdown="@string/please_prov_job"
        app:typeDualDropdown1="text"
        app:typeDualDropdown2="text"
        app:hintDualDropdown1="@string/enter_your_job_designation"
        app:hintDualDropdown2="@string/enter_your_department"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.example.scstrade.views.widgets.DualDropdownSelectorView
        android:id="@+id/employer_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:titleDualDropdown="@string/please_prov_employer"
        app:typeDualDropdown1="text"
        app:typeDualDropdown2="text"
        app:hintDualDropdown1="@string/enter_your_job_employer_name"
        app:hintDualDropdown2="@string/enter_your_employer_address"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/job_details" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:gravity="center_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="0.8"
                android:text="Back"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.2"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="0.8"
                android:text="Continue" />
        </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>