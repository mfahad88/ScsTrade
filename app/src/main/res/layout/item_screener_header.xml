<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorDarkerr"
    android:orientation="horizontal">

    <!-- Sticky Symbol Column -->
    <TextView
        android:layout_width="@dimen/dp_130"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="Symbol"
        android:textAppearance="@style/price_to_ea"
        android:textFontWeight="500" />

    <!-- Scrollable Header Fields -->
    <com.example.scstrade.views.widgets.CustomHorizontalScrollView
        android:id="@+id/horizontalScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/colorDarkerr">

            <!-- Order from Screenshot -->
            <TextView style="@style/ScreenerHeader" android:text="Share Price" />
            <TextView style="@style/ScreenerHeader" android:text="Price To Earning" />
            <TextView style="@style/ScreenerHeader" android:text="Expected Price To Earning" />
            <TextView style="@style/ScreenerHeader" android:text="Dividend Yield" />
            <TextView style="@style/ScreenerHeader" android:text="Price To BookValue" />
            <TextView style="@style/ScreenerHeader" android:text="Return On Assets" />
            <TextView style="@style/ScreenerHeader" android:text="Return On Equity" />
            <TextView style="@style/ScreenerHeader" android:text="Enterprise Value To EBITDA" />

            <!-- Remaining Fields (place at the end) -->
            <TextView style="@style/ScreenerHeader" android:text="EBITA Margin" />
            <TextView style="@style/ScreenerHeader" android:text="Gross Profit Margin" />
            <TextView style="@style/ScreenerHeader" android:text="Payout Ratio" />
            <TextView style="@style/ScreenerHeader" android:text="Price Earning Growth" />
            <TextView style="@style/ScreenerHeader" android:text="Total Debt To Assets" />
            <TextView style="@style/ScreenerHeader" android:text="Total Debt To Equity" />

        </LinearLayout>
    </com.example.scstrade.views.widgets.CustomHorizontalScrollView>
</LinearLayout>
