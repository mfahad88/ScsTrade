<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/dp_15"
    tools:context=".views.aof.fragments.kyc.basicData.KycBasicDataTwoFragment">


    <com.example.scstrade.views.widgets.DualOptionToggleView
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleButton1="@string/single"
        app:titleButton2="@string/married"
        app:titleDualOption="@string/select_your"
        android:id="@+id/marital_status"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_170"
        app:cardElevation="@dimen/dp_0"
        app:strokeWidth="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/marital_status" >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_15"
            android:background="@color/md_theme_surfaceBright">

            <TextView
                android:id="@+id/choose_your"
                android:textFontWeight="500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_your"
                android:textAppearance="@style/select_your"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_55"
                android:layout_below="@id/choose_your"
                android:id="@+id/family"
                android:gravity="center"
                android:weightSum="1">

                <RelativeLayout
                    android:id="@+id/btn_father"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:background="@drawable/drawable_toggle">

                    <TextView
                        android:id="@+id/textFather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/father"
                        android:textAppearance="@style/single_btn" />

                </RelativeLayout>

                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1" />

                <RelativeLayout
                    android:id="@+id/btn_husband"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:background="@drawable/drawable_toggle">

                    <TextView
                        android:id="@+id/textHusband"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/husband"
                        android:textAppearance="@style/single_btn" />

                </RelativeLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_below="@id/family"
                app:cardCornerRadius="@dimen/dp_4"
                app:cardElevation="@dimen/dp_0"
                app:strokeColor="@color/md_theme_outline">

                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:maxLines="1"
                    android:digits="@string/alphabets"
                    android:inputType="textPersonName"
                    android:hint="@string/please_enter_name"
                    android:paddingHorizontal="@dimen/dp_16" />

            </com.google.android.material.card.MaterialCardView>




        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_55"
        android:orientation="horizontal"
        android:weightSum="2"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Back"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="0.2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Continue" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>