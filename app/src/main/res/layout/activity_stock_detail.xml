<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    tools:context=".views.portfolio.activities.StockDetailActivity">


    <com.example.scstrade.views.widgets.mMarket
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:id="@+id/toolbar"/>

    <com.google.android.material.tabs.TabLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tabLayout"
        android:layout_below="@id/toolbar"
        app:tabBackground="@color/md_theme_surface">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/summary" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/holding" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabLayout"
        android:layout_marginTop="@dimen/dp_0" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:clickable="true"
        android:contentDescription="Add to watchlist"
        style="@style/CustomFloatingActionButton"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/baseline_add_24"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_menu"
        android:layout_width="@dimen/dp_146"
        android:layout_height="wrap_content"
        android:layout_above="@+id/floatingActionButton"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dp_15"
        android:layout_alignRight="@id/floatingActionButton"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardElevation="@dimen/dp_2"
        app:strokeWidth="@dimen/dp_0"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/dp_10">

            <TextView
                android:id="@+id/new_buy_trade"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:lineSpacingExtra="3sp"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/new_buy_trade"
                android:textAppearance="@style/new_buy_trade"
                android:textFontWeight="500" />

            <TextView
                android:id="@+id/sell_trade"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:lineSpacingExtra="3sp"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/sell_trade"
                android:textAppearance="@style/new_buy_trade"
                android:textFontWeight="500"
                android:visibility="visible" />


            <TextView
                android:id="@+id/add_dividend"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:lineSpacingExtra="3sp"
                android:paddingVertical="@dimen/dp_5"
                android:text="@string/add_dividend"
                android:textAppearance="@style/new_buy_trade"
                android:textFontWeight="500" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>