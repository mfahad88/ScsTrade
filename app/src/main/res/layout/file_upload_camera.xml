<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:strokeWidth="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_theme_surfaceContainerLowest"
        android:paddingHorizontal="15dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/nominee_nic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nominee_nic"
            android:textAppearance="@style/nominee_nic"
            android:textFontWeight="500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:src="@drawable/icon_info"
            app:layout_constraintBottom_toBottomOf="@+id/nominee_nic"
            app:layout_constraintStart_toEndOf="@+id/nominee_nic"
            app:layout_constraintTop_toTopOf="@+id/nominee_nic" />

        <TextView
            android:id="@+id/required"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/required"
            android:textAppearance="@style/required"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/nominee_nic"
            app:layout_constraintTop_toTopOf="@+id/nominee_nic" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialSelect"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1A73E8"
            app:cardCornerRadius="4dp"
            app:contentPaddingLeft="15dp"
            app:contentPaddingRight="15dp"
            app:layout_constraintEnd_toStartOf="@+id/required"
            app:layout_constraintStart_toStartOf="@+id/nominee_nic"
            app:layout_constraintTop_toBottomOf="@+id/nominee_nic"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/select_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="@string/select_file"
                android:textAppearance="@style/select_file" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end|center_vertical"
                android:rotation="180"
                android:src="@drawable/arrow_back"
                app:tint="#ffffff" />

        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardUpload"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:cardBackgroundColor="@color/colorDarkerr"
            app:cardCornerRadius="5dp"
            app:layout_constraintEnd_toEndOf="@+id/required"
            app:layout_constraintTop_toTopOf="@+id/materialSelect">

            <ImageView
                android:id="@+id/upload_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:tint="#ffffff"
                android:src="@drawable/icon_camera" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="27dp"
            android:visibility="gone"
            android:id="@+id/file_name"
            android:layout_marginEnd="96dp"
            app:layout_constraintEnd_toEndOf="@+id/materialSelect"
            app:layout_constraintStart_toStartOf="@+id/materialSelect"
            app:layout_constraintTop_toBottomOf="@+id/materialSelect" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</com.google.android.material.card.MaterialCardView>