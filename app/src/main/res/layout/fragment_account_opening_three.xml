<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tell_us_abo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="19dp"
        android:layout_marginTop="23dp"
        android:gravity="top"
        android:lineSpacingExtra="3sp"
        android:text="@string/upload_all_"
        android:textAppearance="@style/tell_us_abo"
        android:textFontWeight="500"
        android:translationY="-1.4sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/proof_of_ib"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textFontWeight="500"
        android:layout_marginTop="23dp"
        android:text="@string/proof_of_ib"
        android:textAppearance="@style/proof_of_ib"
        android:translationY="-3.82sp"
        app:layout_constraintStart_toStartOf="@+id/tell_us_abo"
        app:layout_constraintTop_toBottomOf="@+id/tell_us_abo" />
    <ImageView
        android:id="@+id/imageView28"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="9dp"
        android:src="@drawable/icon_info"
        app:layout_constraintStart_toEndOf="@+id/proof_of_ib"
        app:layout_constraintTop_toTopOf="@+id/proof_of_ib" />



    <androidx.cardview.widget.CardView
        android:id="@+id/cardIban"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="66dp"
        app:cardBackgroundColor="#1A73E8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/proof_of_ib"
        app:layout_constraintTop_toBottomOf="@+id/proof_of_ib">

        <RelativeLayout
            android:id="@+id/select_iban"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/select_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:text="@string/select_file"
                android:textAppearance="@style/select_file" />

            <ImageView
                android:id="@+id/imageView26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:rotation="180"
                android:src="@drawable/baseline_arrow_back_ios_24" />

        </RelativeLayout>


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/required_iban"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/required"
        android:textStyle="italic"
        android:textAppearance="@style/required"
        app:layout_constraintBottom_toTopOf="@+id/cardViewIcon"
        app:layout_constraintEnd_toEndOf="@+id/cardViewIcon" />


    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewIcon"
        android:layout_width="34dp"
        android:layout_height="30dp"
        android:layout_marginEnd="15dp"
        app:cardBackgroundColor="@color/colorDarkerr"
        app:layout_constraintBottom_toBottomOf="@+id/cardIban"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardIban"
        app:layout_constraintVertical_bias="1.0">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/icon_camera"
            app:tint="@android:color/white" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/nic_front"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textFontWeight="500"
        android:layout_marginTop="23dp"
        android:text="@string/nic_front"
        android:textAppearance="@style/proof_of_ib"
        app:layout_constraintStart_toStartOf="@+id/cardIban"
        app:layout_constraintTop_toBottomOf="@+id/cardIban" />
    <ImageView
        android:id="@+id/imageViewNicInfo"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_info"
        app:layout_constraintStart_toEndOf="@+id/nic_front"
        app:layout_constraintTop_toTopOf="@+id/nic_front" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="66dp"
        app:cardBackgroundColor="@color/md_theme_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nic_front"
        app:layout_constraintTop_toBottomOf="@+id/nic_front">

        <RelativeLayout
            android:id="@+id/select_nic"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/view_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:text="@string/view_file"
                android:textAppearance="@style/select_file" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:src="@drawable/icon_upload" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewIconDelete"
        android:layout_width="34dp"
        android:layout_height="0dp"
        android:layout_marginEnd="15dp"
        app:cardBackgroundColor="@color/colorDarkerr"
        app:layout_constraintBottom_toBottomOf="@+id/cardView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardView2">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/baseline_delete_24"
            app:tint="@android:color/white" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/required_nic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/required"
        android:textStyle="italic"
        android:textAppearance="@style/required"
        app:layout_constraintBottom_toTopOf="@+id/cardViewIconDelete"
        app:layout_constraintEnd_toEndOf="@+id/cardViewIconDelete" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="0.8"
            android:text="Back"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continue_"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="0.8"
            android:text="Continue" />
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>