<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp_15"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tell_us_abo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_19"
        android:layout_marginTop="@dimen/dp_23"
        android:gravity="top"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="3sp"
        android:text="@string/upload_all_"
        android:textAppearance="@style/tell_us_abo"
        android:textFontWeight="500"
        android:translationY="-1.4sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.scstrade.views.widgets.FileUploadCamera
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/proof_of_ib"
        android:layout_below="@id/tell_us_abo"
        app:titleFileUpload="@string/proof_of_ib"
        app:colorFileUpload="#1A73E8"
        android:layout_marginTop="@dimen/dp_15"/>

    <com.example.scstrade.views.widgets.FileUploadCamera
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/nic_front"
        android:layout_below="@id/proof_of_ib"
        app:titleFileUpload="@string/nic_front"
        app:colorFileUpload="#1A73E8"
        android:layout_marginTop="@dimen/dp_15"/>


    <com.example.scstrade.views.widgets.FileUploadCamera
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/nic_back"
        android:layout_below="@id/nic_front"
        app:titleFileUpload="@string/nic_back"
        app:colorFileUpload="#1A73E8"
        android:layout_marginTop="@dimen/dp_15"/>

    <com.example.scstrade.views.widgets.FileUploadCamera
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/proof_of_relative"
        android:layout_below="@id/nic_back"
        app:titleFileUpload="@string/proof_of_relative"
        app:colorFileUpload="#1A73E8"
        android:layout_marginTop="@dimen/dp_15"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_55"
        android:orientation="horizontal"
        android:weightSum="2"
        android:gravity="center_horizontal"
        android:layout_alignParentBottom="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Back"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="0.2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_50"
            android:layout_weight="0.8"
            android:text="Continue" />
    </LinearLayout>




</RelativeLayout>