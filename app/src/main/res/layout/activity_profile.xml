<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:context=".views.profile.ProfileActivity">

    <com.example.scstrade.views.widgets.mMarket
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/snapshot_card"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/building_bl"
                android:gravity="center"
                android:text="@string/initial"
                android:textAppearance="@style/initial"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/syed_abdull"
                android:textAppearance="@style/syed_abdull"
                android:textFontWeight="600"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <TextView
                android:id="@+id/profile_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="test@gmail.com"
                android:textAppearance="@style/email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_name" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/basic_infor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="top"
        android:lineSpacingExtra="5sp"
        android:textFontWeight="700"
        android:text="@string/basic_infor"
        android:textAppearance="@style/basic_infor"
        app:layout_constraintStart_toStartOf="@+id/materialCardView5"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView5" />


    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/fullName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:inputType="text"
        app:hintText="Full Name"
        app:hintTextField="Enter Full Name"
        app:layout_constraintEnd_toEndOf="@+id/materialCardView5"
        app:layout_constraintStart_toStartOf="@+id/basic_infor"
        app:layout_constraintTop_toBottomOf="@+id/basic_infor" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="97dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:strokeWidth="1dp"
        app:cardCornerRadius="6dp"
        android:id="@+id/countryCard"
        app:strokeColor="@color/md_theme_onSurfaceVariant"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintStart_toStartOf="@+id/fullName"
        app:layout_constraintTop_toBottomOf="@+id/fullName">

        <Spinner
            android:id="@+id/countryCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:entries="@array/spinner_country"
            android:paddingVertical="5dp"
            />
    </com.google.android.material.card.MaterialCardView>


    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/mobileNumber"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:inputType="text"
        app:hintText="Mobile Number"
        app:hintTextField="Enter Mobile Number"
        app:layout_constraintBottom_toBottomOf="@+id/countryCard"
        app:layout_constraintEnd_toEndOf="@+id/fullName"
        app:layout_constraintStart_toEndOf="@+id/countryCard"
        app:layout_constraintTop_toTopOf="@+id/countryCard" />

    <com.example.scstrade.views.widgets.LabelledTextField
        android:id="@+id/email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:inputType="text"
        app:hintText="Email"
        app:hintTextField="Enter Email"
        app:layout_constraintEnd_toEndOf="@+id/materialCardView5"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/basic_infor"
        app:layout_constraintTop_toBottomOf="@+id/mobileNumber" />

    <Button
        android:id="@+id/buttonSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save &amp; Change"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/email"
        app:layout_constraintStart_toStartOf="@+id/email" />
</androidx.constraintlayout.widget.ConstraintLayout>