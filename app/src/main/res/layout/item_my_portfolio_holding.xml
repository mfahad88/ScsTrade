<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardBackgroundColor="@color/white"
    card_view:cardElevation="1dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_15"
        android:paddingVertical="@dimen/dp_7"
        android:orientation="horizontal"
        android:gravity="top"
        android:baselineAligned="false">

        <!-- Logo + Symbol -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:orientation="vertical"
            android:gravity="start">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:src="@drawable/image"
                android:contentDescription="Logo" />

            <TextView
                android:id="@+id/tvSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OGDC"

                android:textFontWeight="700"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRICE"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500" />


            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,100"
                android:textFontWeight="700"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black" />

            <com.example.scstrade.views.widgets.ColoredValueTextView
                android:id="@+id/tvPriceChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                android:gravity="start"
                android:text="7.01"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500" />

        </LinearLayout>

        <!-- Column 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHARES"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500"/>

            <TextView
                android:id="@+id/tvShares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500"
                android:text="1,100"

                 />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG BUY"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500"
                android:layout_marginTop="@dimen/dp_2" />

            <TextView
                android:id="@+id/tvAvgBuy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="209.87"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL COST"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500"
                android:layout_marginTop="@dimen/dp_2" />

            <TextView
                android:id="@+id/tvTotalCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="230,856"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500" />
        </LinearLayout>

        <!-- Column 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARKET VALUE"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500" />

            <TextView
                android:id="@+id/tvMarketValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="248,314"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAY'S P&amp;L"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500"
                android:layout_marginTop="@dimen/dp_2" />

            <com.example.scstrade.views.widgets.ColoredValueTextView
                android:id="@+id/tvDayPL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,507"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="DAY'S P&amp;L %"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500" />

            <com.example.scstrade.views.widgets.ColoredValueTextView
                android:id="@+id/tvDayPLPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.60%"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500"/>
        </LinearLayout>

        <!-- Column 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_4"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/snapshot"
                    android:padding="4dp"
                    android:src="@drawable/snapshot_icon_portfolio"
                    />


                <ImageView
                    android:id="@+id/sell"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:padding="4dp"
                    android:src="@drawable/sell_icon" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="TOTAL P&amp;L"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500" />

            <com.example.scstrade.views.widgets.ColoredValueTextView
                android:id="@+id/tvTotalPL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17,458"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL P&amp;L %"
                android:textAppearance="@style/tvHeading"
                android:textFontWeight="500"
                android:layout_marginTop="@dimen/dp_2" />

            <com.example.scstrade.views.widgets.ColoredValueTextView
                android:id="@+id/tvTotalPLPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7.56%"
                android:textAppearance="@style/tvShares"
                android:textFontWeight="500" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

