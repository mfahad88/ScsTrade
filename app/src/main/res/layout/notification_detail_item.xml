<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/dp_15"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/mcbim_funds"
        app:layout_constraintStart_toStartOf="parent"
        android:textFontWeight="700"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/mcbim_funds" />


    <TextView
        android:id="@+id/company_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:textFontWeight="500"
        android:gravity="center_horizontal|center_vertical"
        android:textAppearance="@style/crescent_st"
        app:layout_constraintStart_toStartOf="@+id/symbol"
        app:layout_constraintTop_toBottomOf="@+id/symbol"
        tools:text="@string/crescent_st" />

    <TextView
        android:id="@+id/description"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center_vertical"
        android:lineSpacingExtra="1sp"
        tools:text="@string/notice_for_"
        android:textAppearance="@style/notice_for_"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/symbol"
        app:layout_constraintTop_toBottomOf="@+id/company_name" />

    <TextView
        android:id="@+id/datetime"
        android:layout_width="@dimen/dp_159"
        android:layout_height="@dimen/dp_20"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:lineSpacingExtra="3sp"
        android:textFontWeight="500"
        android:text="@string/mar_2025_12"
        android:textAppearance="@style/mar_2025_12"
        app:layout_constraintStart_toStartOf="@+id/description"
        app:layout_constraintTop_toBottomOf="@+id/description" />

    <ImageView
        android:id="@+id/imageViewView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/description"
        app:layout_constraintTop_toBottomOf="@+id/datetime"
        app:srcCompat="@drawable/rounded_file_view" />

    <ImageView
        android:id="@+id/imageViewDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewView"
        app:layout_constraintStart_toEndOf="@+id/imageViewView"
        app:layout_constraintTop_toTopOf="@+id/imageViewView"
        app:srcCompat="@drawable/rounded_file_download" />

    <ImageView
        android:id="@+id/imageViewShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewDownload"
        app:layout_constraintStart_toEndOf="@+id/imageViewDownload"
        app:layout_constraintTop_toTopOf="@+id/imageViewDownload"
        app:srcCompat="@drawable/rounded_file_share" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_667"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewDownload" />


</androidx.constraintlayout.widget.ConstraintLayout>