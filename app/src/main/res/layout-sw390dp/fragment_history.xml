<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/loader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/md_theme_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:context=".views.portfolio.fragments.HoldingFragment">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_current_mar"
                android:layout_width="@dimen/dp_190"
                android:layout_height="@dimen/dp_60"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_8"
                app:cardBackgroundColor="@color/md_theme_surfaceBright"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="@dimen/dp_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/historical_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:text="@string/historical_"
                        android:textAppearance="@style/current_mar" />

                    <TextView
                        android:id="@+id/historical_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:text="@string/historical_value"
                        android:textAppearance="@style/historical_value"
                        android:textFontWeight="700" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/holdings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/card_current_mar"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_16"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_current_mar">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_59"
                    android:layout_gravity="start"
                    android:layout_weight="0.975"
                    app:cardBackgroundColor="@color/portfolio_green"
                    app:strokeColor="@color/md_theme_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/net_p_l_on_"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/dp_5"
                            android:text="@string/net_p_l_on_"
                            android:textAppearance="@style/days_p_l_ho"
                            android:textFontWeight="400" />

                        <TextView
                            android:id="@+id/net_p_l_on_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_horizontal|top"
                            android:text="@string/net_p_l_on_value"
                            android:textAppearance="@style/net_p_l_on_value"
                            android:textFontWeight="600" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.05" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_59"
                    android:layout_gravity="end"
                    android:layout_weight="0.975"
                    app:cardBackgroundColor="@color/md_theme_surface"
                    app:strokeColor="@color/md_theme_onSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dividend_ea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/dp_5"
                            android:text="@string/dividend_ea"
                            android:textAppearance="@style/dividend_ea"
                            android:textFontWeight="400" />

                        <TextView
                            android:id="@+id/dividend_ea_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_horizontal|top"
                            android:text="@string/dividend_ea_value"
                            android:textAppearance="@style/dividend_ea_value"
                            android:textFontWeight="600" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_24"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal"
                android:weightSum="4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/holdings">

                <TextView
                    android:id="@+id/profit_book"
                    android:layout_width="@dimen/dp_2"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/profit_book"
                    android:textAppearance="@style/purchase_co" />

                <TextView
                    android:id="@+id/loss_booked"
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/loss_booked"
                    android:textAppearance="@style/purchase_co" />

                <TextView
                    android:id="@+id/purchased_c"
                    android:layout_width="@dimen/dp_15"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/purchased_c"
                    android:textAppearance="@style/purchase_co" />

                <TextView
                    android:id="@+id/sold"
                    android:layout_width="@dimen/dp_2"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/sold"
                    android:textAppearance="@style/purchase_co" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_24"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_2"
                android:orientation="horizontal"
                android:weightSum="4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header">

                <TextView
                    android:id="@+id/profit_book_value"
                    android:layout_width="@dimen/dp_2"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/profit_book_value"
                    android:textAppearance="@style/purchase_co_value"
                    android:textFontWeight="600" />


                <TextView
                    android:id="@+id/loss_booked_value"
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/loss_booked_value"
                    android:textAppearance="@style/purchase_co_value"
                    android:textFontWeight="600" />


                <TextView
                    android:id="@+id/purchased_c_value"
                    android:layout_width="@dimen/dp_15"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/purchased_c_value"
                    android:textAppearance="@style/purchase_co_value"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/sold_value"
                    android:layout_width="@dimen/dp_2"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/sold_value"
                    android:textAppearance="@style/purchase_co_value"
                    android:textFontWeight="600" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardViewSell"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:visibility="gone"
                app:contentPaddingBottom="@dimen/dp_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout6"
                app:strokeWidth="@dimen/dp_0"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/md_theme_primary"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_12">

                        <TextView
                            android:id="@+id/buy_transac"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/sell_trades"
                            android:textAppearance="@style/buy_transac"
                            android:textFontWeight="400"

                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorDarkerr"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_5"
                        android:weightSum="5">

                        <TextView
                            android:id="@+id/buy_date"
                            android:layout_width="@dimen/dp_35"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/date_qty"
                            android:textAppearance="@style/buy_date" />

                        <TextView
                            android:id="@+id/shares"
                            android:layout_width="@dimen/dp_25"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/net_price"
                            android:textAppearance="@style/buy_date" />

                        <TextView
                            android:id="@+id/price_cost"
                            android:layout_width="@dimen/dp_25"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/net_value"
                            android:textAppearance="@style/buy_date" />

                        <TextView
                            android:id="@+id/current_p_l"
                            android:layout_width="@dimen/dp_25"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/p_l_on_sell"
                            android:textAppearance="@style/buy_date" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_history" />
                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/materialCardViewDividend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/materialCardViewSell"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_60"
                    android:background="@color/md_theme_primary"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_12">

                    <TextView
                        android:id="@+id/dividends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/dividend_trades"
                        android:textAppearance="@style/buy_transac"
                        android:textFontWeight="400" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorDarkerr"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_5"
                    android:weightSum="4">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date"
                        android:textAppearance="@style/buy_date" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.7"
                        android:text="Shares"
                        android:textAppearance="@style/buy_date" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Div per Shr"
                        android:textAppearance="@style/buy_date" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:text="Total Dividend"
                        android:textAppearance="@style/buy_date" />
                </LinearLayout>

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/mainContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>